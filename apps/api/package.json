{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "start": "node --experimental-strip-types src/index.ts",
    "check": "node --experimental-strip-types src/app.check.ts",
    "check:isolation": "node --experimental-strip-types src/db/isolation.check.ts",
    "check:auth-schema": "node --experimental-strip-types src/db/schema.auth.check.ts",
    "check:crypto": "node --experimental-strip-types src/crypto/envelope.check.ts && node --experimental-strip-types src/routers/projects.secrets.check.ts && node --experimental-strip-types src/routers/credentials.reveal.check.ts",
    "check:audit": "node --experimental-strip-types src/audit/diff.check.ts && node --experimental-strip-types src/routers/audit.check.ts",
    "check:filters": "node --experimental-strip-types src/routers/projects.filters.check.ts",
    "lint": "pnpm check && pnpm check:isolation && pnpm check:crypto && pnpm check:auth-schema && pnpm check:audit && pnpm check:filters",
    "build": "pnpm lint"
  },
  "dependencies": {
    "@better-auth/infra": "^0.4.2",
    "@hono/node-server": "^1.19.9",
    "@hono/trpc-server": "^0.4.2",
    "@trpc/server": "^11.18.0",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.11.7",
    "postgres": "^3.4.9",
    "shared": "workspace:*",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.6",
    "@types/node": "^24.13.3",
    "drizzle-kit": "^0.31.10"
  }
}
