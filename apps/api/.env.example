# Local Ubuntu/Debian (peer auth). TCP @localhost usually needs a password.
DATABASE_URL=postgres:///projects_manager
BETTER_AUTH_API_KEY=
BETTER_AUTH_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
MASTER_KEY=
RESEND_API_KEY=
EMAIL_FROM=Projects Manager <noreply@example.com>
RESEND_TEMPLATE_CONFIRM=auth-confirm
RESEND_TEMPLATE_LOGIN=auth-login
PORT=3100
NODE_ENV=development
