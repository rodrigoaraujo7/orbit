# Local Ubuntu/Debian (peer auth). TCP @localhost usually needs a password.
DATABASE_URL=postgres:///projects_manager
BETTER_AUTH_SECRET=
# Leave empty to keep the Better Auth dashboard (/api/auth/dash/*) unmounted.
# It only mounts with 32+ chars and 12+ distinct characters.
BETTER_AUTH_API_KEY=
BETTER_AUTH_URL=http://localhost:5173
AUTH_TRUSTED_ORIGIN=
WEB_ORIGIN=http://localhost:5173
MASTER_KEY=
# Leave empty to print codes and links to the console instead of sending mail.
RESEND_API_KEY=
EMAIL_FROM=Projects Manager <noreply@projectsmanager.rodrigoleite.dev>
# Template aliases without the locale suffix; the sender appends -en-us / -pt-br.
RESEND_TEMPLATE_LOGIN_OTP=pm-login-otp
RESEND_TEMPLATE_CONFIRM_ACCOUNT=pm-confirm-account
RESEND_TEMPLATE_RESET_PASSWORD=pm-reset-password
RESEND_TEMPLATE_NEW_LOGIN=pm-new-login
PORT=3100
NODE_ENV=development
