# Local Ubuntu/Debian (peer auth). TCP @localhost usually needs a password.
DATABASE_URL=postgres:///orbit
BETTER_AUTH_SECRET=
# Leave empty to keep the Better Auth dashboard (/api/auth/dash/*) unmounted.
# It only mounts with 32+ chars and 12+ distinct characters.
BETTER_AUTH_API_KEY=
BETTER_AUTH_URL=http://localhost:5173
AUTH_TRUSTED_ORIGIN=
# Comma-separated IPs or CIDRs. Replaces the built-in Vercel egress ranges
# used to give each visitor their own auth rate-limit bucket. Invalid entries
# refuse auth setup. Leave empty to keep the built-in ranges.
AUTH_TRUSTED_PROXIES=
WEB_ORIGIN=http://localhost:5173
MASTER_KEY=
# Required. Boot and mail send fail without a Resend API key.
RESEND_API_KEY=
# Must be a verified Resend domain. Unverified senders fail the mail send.
EMAIL_FROM=Orbit <noreply@orbit.rodrigoleite.dev>
# Template aliases without the locale suffix; the sender appends -en-us / -pt-br.
RESEND_TEMPLATE_LOGIN_OTP=orbit-login-otp
RESEND_TEMPLATE_CONFIRM_ACCOUNT=orbit-confirm-account
RESEND_TEMPLATE_RESET_PASSWORD=orbit-reset-password
RESEND_TEMPLATE_NEW_LOGIN=orbit-new-login
PORT=3100
NODE_ENV=development
