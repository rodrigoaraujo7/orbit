{
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }],
  // Inerte para o build (files: []), existe só para ferramentas que leem o
  // tsconfig raiz — sem isso o CLI do shadcn cria uma pasta literal "@/".
  // Vercel transpiles middleware.ts with this file. Without the rewrite flag
  // the emitted JavaScript keeps `.ts` import specifiers and Node never loads it.
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
